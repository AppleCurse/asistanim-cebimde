# Asistanım Cebimde — Ortam Değişkenleri
# Kopyala: cp .env.example .env  → sonra scripts/termux/baslat.sh bunu otomatik yükler.

# --- Kimlik ---
KULLANICI_ADI="Gümüş"                  # Asistanın temsil ettiği kişi (aramalarda "Gümüş'ün asistanıyım" der)
ASISTAN_ADI=Aspasia                    # Asistanın adı

# --- Doğrudan Bulut AI Sağlayıcıları (9router alternatifi / yedeği) ---
OPENROUTER_API_KEY=                    # sk-or-v1-... (meta-llama/llama-3.3-70b-instruct)
GROQ_API_KEY=                          # gsk_... (Whisper Large v3 Turbo STT)
CEREBRAS_API_KEY=                      # csk-... (Ultra hızlı Llama 3.3 çıkarımı)
# Maliyet panosu için seçtiğin sağlayıcının USD / 1K token fiyatını yaz (0 = yalnız token sayacı).
LLM_PROMPT_USD_PER_1K=0
LLM_COMPLETION_USD_PER_1K=0
TAVILY_API_KEY=                        # tvly-... (İnternet arama aracı)
GEMINI_API_KEY=                        # Gemini API anahtarı

# --- LLM Yapılandırması (Panel Beyni: Sohbet + Araçlar + Kamera) ---
LLM_BASE_URL=https://openrouter.ai/api/v1  # veya yerel 9router için: http://127.0.0.1:20128/v1
LLM_API_KEY=                           # 9router veya OpenRouter API anahtarı
LLM_MODEL=google/gemini-2.5-flash

# --- Arama Motoru LLM Yapılandırması (Gecikmesiz VoIP/SIP Aramaları) ---
ARAMA_LLM_BASE_URL=https://api.groq.com/openai/v1   # veya Cerebras: https://api.cerebras.ai/v1
ARAMA_LLM_MODEL=openai/gpt-oss-120b                 # veya openai/gpt-oss-20b / gpt-oss-120b
ARAMA_LLM_API_KEY=                                 # boşsa GROQ_API_KEY veya CEREBRAS_API_KEY otomatik kullanılır

# --- Kulak (STT) ve Ağız (TTS) ---
STT_SAGLAYICI=groq                     # groq (Whisper Large v3) | android | 9router
STT_MODEL=whisper-large-v3-turbo

TTS_SAGLAYICI=piper                  # piper (yerel, ağsız) | elevenlabs (ultra kaliteli) | edge-tts | android | 9router
ELEVENLABS_API_KEY=                     # sk_... ElevenLabs API anahtarı
ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9 # Jessica (doğal, akıcı); alternatifler: Bella (hpp4J3VqNfWAUOO0d1Us), Lily (pFZP5JQG7iQjIQuC4Bku)
ELEVENLABS_MODEL=eleven_multilingual_v2 # Çok dilli Türkçe destekli model
# Piper kurulumu: pkg install piper; Türkçe .onnx modelini cihazda tut, yolunu ver.
PIPER_BIN=piper
PIPER_MODEL=                           # örn. $HOME/models/tr_TR-dfki-medium.onnx
TTS_VOICE=tr-TR-EmelNeural             # Piper/ElevenLabs seçili değilse edge-tts fallback sesidir
TTS_MODEL=tts-1

# --- VoIP / SIP (Zadarma / Baresip) ---
SIP_USER=                                  # SIP kullanıcı adı / dahili numara (örn: 101)
SIP_PASS=                                  # SIP şifresi
SIP_SERVER=pbx.zadarma.com                 # SIP sunucu adresi
SIP_PORT=5060                          # SIP portu

# --- Dış erişim (isteğe bağlı Cloudflare named tunnel) ---
# Cloudflare Zero Trust panelinde tunnel + hostname + https://localhost:20131 origin oluştur.
# Tunnel tokenını yalnızca cihazdaki ignored .env dosyasına koy; servis token dosyasını 0600 ile yazar.
CLOUDFLARED_TUNNEL_TOKEN=
CLOUDFLARED_PUBLIC_URL=                 # ör. https://asistan.ornek.com (status ekranında gösterilir)

# --- Beden (Termux cihaz köprüsü) ---
BEDEN_HOST=127.0.0.1
BEDEN_PORT=20130
# BEDEN_MOD=termux                     # termux | mock
# BEDEN_TOKEN=                         # boşsa ~/.asistan/beden.token otomatik üretilir

# --- Beyin (Ajan + Web Paneli + Telefon Köprüsü) ---
BEYIN_HOST=0.0.0.0
BEYIN_PORT=20131
# BEYIN_TOKEN=                         # boşsa ~/.asistan/beyin.token otomatik üretilir
# BEDEN_URL=http://127.0.0.1:20130
# ASISTAN_HOME=/data/data/com.termux/files/home/.asistan
