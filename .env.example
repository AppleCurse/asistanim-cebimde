# Asistanım Cebimde — ortam değişkenleri (isteğe bağlı; ~/.asistan/config.json'u ezer)
# Kopyala: cp .env.example .env  → sonra scripts/termux/baslat.sh bunu otomatik yükler.

# Tüm çalışma verilerinin tutulduğu dizin (ayarlar, tokenlar, fotoğraflar, ses kayıtları, görevler)
# ASISTAN_HOME=/data/data/com.termux/files/home/.asistan

# --- Beyin → 9router (LLM + STT + TTS musluğu) ---
LLM_BASE_URL=http://127.0.0.1:20128/v1
LLM_API_KEY=            # 9router panelinden (http://localhost:20128) kopyala
LLM_MODEL=              # örn: kr/claude-sonnet-4.5  (boşsa /v1/models'tan ilk model seçilir)
STT_MODEL=whisper-1     # 9router'da bağlı bir STT sağlayıcısı varsa
TTS_MODEL=tts-1
TTS_VOICE=alloy

# Kulak ve ağız için sağlayıcı: "android" (Termux:API, ücretsiz, cihaz üstü) veya "9router"
STT_SAGLAYICI=android
TTS_SAGLAYICI=android

# --- Beden (Termux cihaz köprüsü) ---
BEDEN_HOST=127.0.0.1
BEDEN_PORT=20130
# BEDEN_MOD=mock        # Termux dışında geliştirirken sahte cihaz
# BEDEN_TOKEN=          # boşsa ~/.asistan/beden.token otomatik üretilir

# --- Beyin (ajan + web paneli + telefon köprüsü) ---
BEYIN_HOST=0.0.0.0
BEYIN_PORT=20131
# BEYIN_TOKEN=          # boşsa ~/.asistan/beyin.token otomatik üretilir
# BEDEN_URL=http://127.0.0.1:20130

# --- Kimlik ---
KULLANICI_ADI=""        # Asistanın temsil ettiği kişi, boşluk varsa tırnakla: "Ali Veli" (aramalarda "X'in asistanıyım" der)
ASISTAN_ADI=Cebi
# CIHAZ_ADI="Xiaomi Redmi Note 8 (Termux)"
